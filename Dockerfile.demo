# All-in-one demo image for free-tier hosts (Render, SnapDeploy).
# Runs server + scheduler + two executors in a single container; state lives
# in Neon Postgres. Use "Dockerfile.demo" as the Dockerfile path in the host UI.

FROM golang:1.26-alpine AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/durablemcp-server ./cmd/server \
 && CGO_ENABLED=0 GOOS=linux go build -o /bin/durablemcp-executor ./cmd/executor \
 && CGO_ENABLED=0 GOOS=linux go build -o /bin/durablemcp-scheduler ./cmd/scheduler \
 && CGO_ENABLED=0 GOOS=linux go build -o /bin/durablemcp-demo-agent ./cmd/demo-agent

FROM alpine:3.21
RUN apk --no-cache add ca-certificates && adduser -D -u 10001 durablemcp
COPY --from=go-builder /bin/durablemcp-server /bin/durablemcp-executor /bin/durablemcp-scheduler /bin/durablemcp-demo-agent /
COPY docker/allinone-entrypoint.sh /allinone-entrypoint.sh
RUN chmod +x /allinone-entrypoint.sh
USER durablemcp

# Render/SnapDeploy route traffic to $PORT; the server binary honors it.
EXPOSE 8080
ENTRYPOINT ["/allinone-entrypoint.sh"]
